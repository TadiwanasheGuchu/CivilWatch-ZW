# Copy to .env for local development. Never commit .env.
# Use URL-safe passwords (letters, digits, - and _): they are embedded in connection URLs.
POSTGRES_USER=civicwatch
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=civicwatch
# Password for civicwatch_app, the unprivileged role the API connects as.
APP_DB_PASSWORD=change-me-app-local-only
