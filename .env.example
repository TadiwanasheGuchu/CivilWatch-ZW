# Copy to .env for local development. Never commit .env.
# Use URL-safe passwords (letters, digits, - and _): they are embedded in connection URLs.
POSTGRES_USER=civicwatch
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=civicwatch
# Password for civicwatch_app, the unprivileged role the API connects as.
APP_DB_PASSWORD=change-me-app-local-only
# Password for civicwatch_worker, the role the background worker uses to email notifications.
WORKER_DB_PASSWORD=change-me-worker-local-only
# Local MinIO (photo storage). The root account is used only by the init job;
# the API gets its own key limited to the media bucket.
MINIO_ROOT_USER=civicwatch-minio-admin
MINIO_ROOT_PASSWORD=change-me-minio-root
STORAGE_ACCESS_KEY_ID=civicwatch-api
STORAGE_SECRET_ACCESS_KEY=change-me-storage-secret
