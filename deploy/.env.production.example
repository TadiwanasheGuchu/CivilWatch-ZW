# Production settings for deploy/compose.prod.yml. Copy to .env.production,
# fill in every value and keep it off version control (it holds secrets).
# Use URL-safe passwords (letters, digits, - and _).

CIVICWATCH_DOMAIN=civicwatch.example.org

# Images published by .github/workflows/release.yml (pin a commit SHA).
API_IMAGE=ghcr.io/OWNER/civilwatch-zw-api:COMMIT_SHA
WEB_IMAGE=ghcr.io/OWNER/civilwatch-zw-web:COMMIT_SHA

POSTGRES_USER=civicwatch
POSTGRES_PASSWORD=
POSTGRES_DB=civicwatch
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=

# A PRIVATE bucket and credentials limited to it. Leave the endpoints empty for AWS S3.
STORAGE_BUCKET=
STORAGE_REGION=af-south-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT_URL=
STORAGE_PUBLIC_ENDPOINT_URL=

# Email (optional). Leave SMTP_HOST empty to send no email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
